<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Email Template for Teacher Notification -->
        <record id="mail_template_lesson_booking_teacher" model="mail.template">
            <field name="name">Lesson Booking Notification for Teacher</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="subject">New Lesson Booking: {{ object.company_id.name }}</field>
            <field name="email_from"></field>
            <field name="email_to">{{ object.package_id.package_id.instructor.email }}</field>
            <field name="body_html">
                <![CDATA[
               
                
                <p style="margin:0px 0 16px 0;box-sizing:border-box;">Hello <t t-out="object.package_id.package_id.instructor.name"></t>,</p>

                <p style="margin:0px 0 16px 0;box-sizing:border-box;">A new lesson has been booked.</p>

                <p style="margin:0px 0 16px 0;box-sizing:border-box;"><strong style="box-sizing:border-box;font-weight:bolder;">Student:</strong> <t t-out="object.order_id.partner_id.name"></t></p>
                <p style="margin:0px 0 16px 0;box-sizing:border-box;"><strong style="box-sizing:border-box;font-weight:bolder;">Lesson:</strong>  <t t-out="object.product_id.name"></t></p>
                <p style="margin:0px 0 16px 0;box-sizing:border-box;"><strong style="box-sizing:border-box;font-weight:bolder;">Date:</strong> <t t-out="object.order_id.date_order.strftime('%Y-%m-%d')"></t></p>

                <p style="margin:0px 0 16px 0;box-sizing:border-box;">Thank you!</p>
                
            
                ]]>
            </field>
        </record>
        <record id="email_template_guest_masterclass" model="mail.template">
            <field name="name">Guest MasterClass Confirmation</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="subject">Your MasterClass Confirmation</field>
            <field name="email_from">{{object.env.company.email or 'no-reply@example.com'}}</field>
            <field name="email_to">{{ object.package_id.package_id.instructor.email }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html">
            <![CDATA[
                <t t-out="object.order_id.partner_id.name"/>, <br/><br/>

                Thank you for purchasing the <strong><t t-out="object.product_id.name"></t></strong> MasterClass! <br/>
                Below are the details of your class: <br/><br/>

                <strong>Class Name:</strong> <t t-out="object.product_id.name"></t> <br/>
                <strong>Instructor:</strong> <t t-out="object.product_id.master_class_id.instructor.name"></t> <br/>
                <strong>Start Date and Time:</strong> <t t-out="object.product_id.master_class_id.datetime_from.strftime('%Y-%m-%d %I:%M %p')"></t> <br/>
                <strong>Meeting Link:</strong> <a t-att-href="object.product_id.master_class_id.zoom">Join Here</a> <br/><br/>

                If you have any questions, feel free to contact us. <br/><br/>

                Best regards, <br/>
                The Team at <t t-out="object.env.company.name"></t>
            ]]>
            </field>
        </record>


    </data>
</odoo>
