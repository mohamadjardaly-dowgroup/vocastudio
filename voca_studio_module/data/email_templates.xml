<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Email Template for Teacher Notification -->
        <record id="mail_template_lesson_booking_teacher" model="mail.template">
            <field name="name">Lesson Booking Notification for Teacher</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="subject">New Lesson Booking: {{ object.company_id.name }}</field>
            <field name="email_from">"Voca Studio SARL" <hello@vocastudio.com></field>
            <field name="email_to">{{ object.package_id.package_id.instructor.email }}</field>
            <field name="body_html">
                <![CDATA[
                <p>Hello ,</p>

                <p>A new lesson has been booked.</p>

                <p><strong>Student:</strong> </p>
                <p><strong>Lesson:</strong> </p>
                <p><strong>Date:</strong> </p>

                <p>Thank you!</p>
                ]]>
            </field>
        </record>

    </data>
</odoo>
