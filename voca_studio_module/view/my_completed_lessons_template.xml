<odoo>
    <template id="completed_lessons_partial" name="Completed Lessons Partial">
        <div>
            <t t-if="completed_bookings">
                <div class="row">
                    <t t-foreach="completed_bookings" t-as="record">
                        <t t-if="record._name == 'voca.teacher.booking.lines'">
                            <!-- Regular Completed Lesson -->
                            <div class="col-md-4 mb-4">
                                <div class="card shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <strong>Teacher:</strong> <t t-esc="record.booking_id.name" />
                                        </h5>
                                        <p class="card-text">
                                            <strong>Date:</strong> <t t-esc="record.availablity_date.strftime('%d %B %Y')" /><br />
                                            <strong>Time:</strong> <t t-esc="record.availablity_date.strftime('%I:%M %p')" /><br />

                                            <!-- <strong>Status:</strong> <t t-esc="record.lesson_state" /> -->
                                        </p>
                                        <!-- <t t-if="record.booking_id.google_meet">
                                            <a t-att-href="record.booking_id.google_meet" class="btn btn-primary btn-block" target="_blank">
                                                View Recording
                                            </a>
                                        </t> -->
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-if="record._name == 'sale.order.line'">
                            <!-- Completed Master Class -->
                            <div class="col-md-4 mb-4">
                                <div class="card shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <strong>Master Class:</strong> <t t-esc="record.product_id.master_class_id.name" />
                                        </h5>
                                        <p class="card-text">
                                            
                                            <t t-if="record.product_id.master_class_id.datetime_from">
                                            <strong>Date:</strong>
                                                <t t-esc="record.product_id.master_class_id.datetime_from.strftime('%d %B %Y')" />
                                                <br/>
                                            <strong>Time:</strong>
                                                <t t-esc="record.product_id.master_class_id.datetime_from.strftime('%I:%M %p')" />

                                            </t>
                                            <t t-else="">
                                                <span class="text-muted">Not Available</span>
                                            </t>
                                            <br />
                                        </p>
                                        <!-- <t t-if="record.product_id.master_class_id.instructor.google_meet">
                                            <a t-att-href="record.product_id.master_class_id.instructor.google_meet" class="btn btn-primary btn-block" target="_blank">
                                                View Recording
                                            </a>
                                        </t> -->
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>

                <!-- Pagination -->
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mt-4">
                        <t t-if="page > 1">
                            <li class="page-item">
                                <a class="page-link" t-att-href="'/my_dashboard/completed-lessons?page=%d' % (page - 1)">Previous</a>
                            </li>
                        </t>
                        <t t-foreach="range(1, total_pages + 1)" t-as="p">
                            <li t-att-class="'page-item ' + ('active' if p == page else '')">
                                <a class="page-link" t-att-href="'/my_dashboard/completed-lessons?page=%d' % p">
                                    <t t-esc="p" />
                                </a>
                            </li>
                        </t>
                        <t t-if="page &lt; total_pages">
                            <li class="page-item">
                                <a class="page-link" t-att-href="'/my_dashboard/completed-lessons?page=%d' % (page + 1)">Next</a>
                            </li>
                        </t>
                    </ul>
                </nav>
            </t>
            <t t-else="">
                <p class="text-center">No completed lessons available.</p>
            </t>
        </div>
    </template>
</odoo>
